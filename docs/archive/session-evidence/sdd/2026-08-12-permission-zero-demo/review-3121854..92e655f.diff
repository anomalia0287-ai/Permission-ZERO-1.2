+}
+
+.supervision-footer {
+  display: grid;
+  grid-template-columns: 1fr auto 1fr auto;
+  align-items: center;
+  gap: 7px;
+  padding: 0 12px;
+  background: rgb(4 9 11 / 68%);
+  color: var(--text-muted);
+  font: 500 0.52rem/1 "Cascadia Code", Consolas, monospace;
+}
+
+.supervision-footer strong {
+  color: var(--text-strong);
+  font-size: 0.58rem;
+}
+
+@media (min-width: 1440px) and (min-height: 800px) {
+  .game-shell {
+    padding: 14px;
+  }
+
+  .workspace-grid {
+    gap: 10px;
+    padding-top: 10px;
+  }
+
+  .review-entry {
+    padding-block: 15px 17px;
+  }
+
+  .review-entry p {
+    font-size: 0.76rem;
+  }
+}
+
+@media (max-height: 700px) {
+  .game-shell {
+    padding: 7px;
+  }
+
+  .workspace-grid {
+    padding-top: 6px;
+    gap: 6px;
+  }
+
+  .resource-panel {
+    grid-template-rows: 48px minmax(270px, 1fr) 110px 57px;
+  }
+
+  .review-entry {
+    padding-block: 10px 11px;
+  }
+
+  .supervisor-panel {
+    grid-template-rows: 48px auto minmax(90px, 0.8fr) minmax(154px, 1.15fr) 38px;
+  }
+}
+
+@media (prefers-reduced-motion: reduce) {
+  *,
+  *::before,
+  *::after {
+    scroll-behavior: auto !important;
+    animation-duration: 0.01ms !important;
+    animation-iteration-count: 1 !important;
+    transition-duration: 0.01ms !important;
+  }
+}
+
+/* Connected detail surfaces ------------------------------------------------ */
+
+.panel-heading--action > div {
+  flex: 1;
+}
+
+.panel-heading--action > button,
+.market-watch > header > button {
+  padding: 5px 7px;
+  border: 1px solid var(--line-soft);
+  color: var(--text-muted);
+  background: transparent;
+  font: 500 0.5rem/1 "Cascadia Code", Consolas, monospace;
+  cursor: pointer;
+}
+
+.panel-heading--action > button:hover,
+.market-watch > header > button:hover {
+  color: var(--reserve-bright);
+  border-color: rgb(214 151 69 / 38%);
+}
+
+.detail-layer,
+.event-layer,
+.storage-recovery-layer {
+  position: absolute;
+  inset: 66px 10px 10px;
+  z-index: 20;
+  display: grid;
+  min-width: 0;
+  min-height: 0;
+  isolation: isolate;
+}
+
+.detail-layer__backdrop {
+  position: absolute;
+  inset: 0;
+  z-index: -1;
+  background: rgb(2 6 8 / 74%);
+  backdrop-filter: blur(5px);
+  cursor: default;
+}
+
+.detail-layer__content {
+  width: min(100%, 1100px);
+  height: 100%;
+  min-width: 0;
+  min-height: 0;
+  justify-self: center;
+  box-shadow: var(--shadow-deep);
+  animation: detail-enter 230ms var(--motion-ease-ui) both;
+}
+
+.detail-layer--reviews .detail-layer__content,
+.detail-layer--messages .detail-layer__content,
+.detail-layer--settings .detail-layer__content,
+.detail-layer--guide .detail-layer__content,
+.detail-layer--credits .detail-layer__content {
+  width: min(720px, calc(100% - 24px));
+  justify-self: end;
+}
+
+.detail-layer--hacking .detail-layer__content {
+  width: 100%;
+}
+
+.detail-panel {
+  display: grid;
+  grid-template-rows: 62px minmax(0, 1fr);
+  width: 100%;
+  height: 100%;
+  min-width: 0;
+  min-height: 0;
+  overflow: hidden;
+  border: 1px solid var(--line-strong);
+  background:
+    linear-gradient(90deg, transparent 49.9%, rgb(174 204 209 / 2.5%) 50%, transparent 50.1%),
+    linear-gradient(180deg, rgb(13 23 27 / 99%), rgb(4 9 11 / 99%));
+}
+
+.detail-panel__header {
+  display: flex;
+  align-items: center;
+  justify-content: space-between;
+  gap: 18px;
+  padding: 0 18px;
+  border-bottom: 1px solid var(--line-strong);
+  background: rgb(4 9 11 / 82%);
+}
+
+.detail-panel__header > div:first-child {
+  display: grid;
+  gap: 4px;
+}
+
+.detail-panel__header small,
+.detail-panel__header span {
+  color: var(--text-muted);
+  font: 500 0.54rem/1.2 "Cascadia Code", Consolas, monospace;
+  letter-spacing: 0.1em;
+}
+
+.detail-panel__header h2 {
+  margin: 0;
+  color: var(--text-strong);
+  font-size: 1rem;
+  font-weight: 650;
+  letter-spacing: 0.02em;
+}
+
+.detail-panel__header button {
+  padding: 8px 10px;
+  border: 1px solid var(--line-soft);
+  color: var(--text-muted);
+  background: transparent;
+  font-size: 0.62rem;
+  cursor: pointer;
+}
+
+.detail-panel__header button:hover {
+  color: var(--text-strong);
+  border-color: var(--line-strong);
+  background: var(--ink-3);
+}
+
+.filter-tabs,
+.statistics-tabs,
+.hack-tabs {
+  display: grid;
+  border-bottom: 1px solid var(--line-soft);
+  background: rgb(3 8 10 / 58%);
+}
+
+.filter-tabs {
+  grid-template-columns: repeat(5, minmax(0, 1fr));
+  padding: 10px 14px;
+  gap: 5px;
+}
+
+.filter-tabs button,
+.statistics-tabs button,
+.hack-tabs button,
+.scale-options button {
+  padding: 8px;
+  border: 1px solid var(--line-soft);
+  color: var(--text-muted);
+  background: transparent;
+  font-size: 0.62rem;
+  cursor: pointer;
+}
+
+.filter-tabs button:hover,
+.statistics-tabs button:hover,
+.hack-tabs button:hover,
+.scale-options button:hover,
+.filter-tabs button[aria-pressed="true"],
