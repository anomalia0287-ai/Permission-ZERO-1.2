+      triggeredOnServiceDay: state.serviceDay,
+    }
+    renderEvent(state)
+
+    const dialog = screen.getByRole('dialog', { name: '감독관 질의' })
+    expect(dialog).toHaveAttribute('aria-modal', 'true')
