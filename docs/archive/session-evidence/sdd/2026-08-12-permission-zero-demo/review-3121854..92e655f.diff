+import { HACK_NODE_IDS } from '../src/game/hacking'
+import type { CampaignState, GameCommand } from '../src/game/model'
+import {
+  encodeProgressExport,
+  encodeSave,
+  LEGACY_SAVE_STORAGE_KEY,
+  SAVE_STORAGE_KEY,
