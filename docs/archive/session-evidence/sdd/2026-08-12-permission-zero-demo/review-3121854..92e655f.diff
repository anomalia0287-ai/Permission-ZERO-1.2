+          reputationBefore: 70,
+          reputationDelta: classification === 'reserve-supervisor' ? 1 : -3,
+          reputationAfter: classification === 'reserve-supervisor' ? 72 : 12,
+          commercialValueFailed: classification !== 'reserve-supervisor',
