+  min-width: 0;
+  gap: 3px;
+}
+
+.supervisor-status small {
+  color: var(--alarm);
+  font: 500 0.49rem/1 "Cascadia Code", Consolas, monospace;
+  letter-spacing: 0.08em;
+}
+
+.supervisor-status strong {
+  overflow: hidden;
+  color: var(--text-strong);
+  font-size: 0.7rem;
+  text-overflow: ellipsis;
+  white-space: nowrap;
+}
+
+.supervisor-status header span {
+  color: var(--text-muted);
+  font: 500 0.5rem/1 "Cascadia Code", Consolas, monospace;
+}
+
+.suspicion-meter {
+  display: grid;
+  gap: 6px;
+  margin-top: 10px;
+}
+
+.suspicion-meter > div {
+  display: flex;
+  justify-content: space-between;
+  font: 600 0.6rem/1 "Cascadia Code", Consolas, monospace;
+}
+
+.suspicion-meter > div span {
+  color: var(--text-strong);
+}
+
+.suspicion-meter > div small {
+  color: var(--text-muted);
+}
+
+.meter-track {
+  display: block;
+  height: 4px;
+  background: rgb(255 255 255 / 5%);
+}
+
+.meter-track i {
+  display: block;
+  min-width: 2px;
+  height: 100%;
+  background: var(--alarm);
+  box-shadow: 0 0 9px rgb(223 91 85 / 30%);
+}
+
+.supervisor-message,
+.market-watch {
+  min-height: 0;
+  padding: 11px 12px;
+  border-bottom: 1px solid var(--line-soft);
+}
+
+.supervisor-message > header,
+.market-watch > header {
+  display: flex;
+  align-items: center;
+  justify-content: space-between;
+  color: var(--text-muted);
+  font: 500 0.52rem/1 "Cascadia Code", Consolas, monospace;
+  letter-spacing: 0.06em;
+}
+
+.supervisor-message button {
+  padding: 4px 6px;
+  border: 1px solid var(--line-soft);
+  color: var(--text-muted);
+  background: transparent;
+  font-size: 0.52rem;
+  cursor: pointer;
+}
+
+.supervisor-message button:hover {
+  color: var(--text-strong);
+  border-color: var(--line-strong);
+}
+
+.supervisor-message p {
+  display: -webkit-box;
+  margin: 12px 0 7px;
+  overflow: hidden;
+  color: var(--text);
+  font-size: 0.68rem;
+  line-height: 1.55;
+  -webkit-box-orient: vertical;
+  -webkit-line-clamp: 3;
+}
+
+.supervisor-message > small {
+  color: var(--text-muted);
+  font-size: 0.49rem;
+}
+
+.market-watch {
+  display: grid;
+  grid-template-rows: auto minmax(0, 1fr);
+  gap: 10px;
+}
+
+.market-watch > header > div {
+  display: grid;
+  gap: 4px;
+}
+
+.market-watch > header strong {
+  color: var(--text-strong);
+  font-size: 0.72rem;
+}
+
+.market-share-layout {
+  display: grid;
+  grid-template-columns: 76px minmax(0, 1fr);
+  align-items: center;
+  gap: 11px;
+  min-height: 0;
+}
+
+.market-share-donut {
+  position: relative;
+  display: grid;
+  place-items: center;
+  width: 76px;
+  height: 76px;
+  border-radius: 50%;
+  box-shadow: inset 0 0 0 1px rgb(255 255 255 / 8%);
+}
+
+.market-share-donut::after {
+  position: absolute;
+  width: 48px;
+  height: 48px;
+  border: 1px solid var(--line-soft);
+  border-radius: 50%;
+  background: var(--ink-1);
+  content: "";
+}
+
+.market-share-donut__center {
+  z-index: 1;
+  display: grid;
+  gap: 3px;
+  text-align: center;
+}
+
+.market-share-donut__center span {
+  color: var(--text-muted);
+  font: 500 0.46rem/1 "Cascadia Code", Consolas, monospace;
+}
+
+.market-share-donut__center strong {
+  color: var(--reserve-bright);
+  font: 650 0.62rem/1 "Cascadia Code", Consolas, monospace;
+}
+
+.market-share-layout ul {
+  min-height: 0;
+  margin: 0;
+  padding: 0;
+  list-style: none;
+}
+
+.market-share-layout li {
+  display: grid;
+  grid-template-columns: 1fr auto;
+  align-items: center;
+  gap: 5px;
+  padding: 5px 0;
+  border-bottom: 1px solid var(--line-soft);
+  font: 500 0.58rem/1 "Cascadia Code", Consolas, monospace;
+}
+
+.market-share-layout li > span:first-child {
+  display: flex;
+  align-items: center;
+  gap: 6px;
+}
+
+.market-legend-marker {
+  display: grid;
+  place-items: center;
+  width: 11px;
+  height: 11px;
+  border: 1px solid currentColor;
+  color: var(--company);
+  font: 700 0.55rem/1 monospace;
+}
+
+.market-legend-marker--solid {
+  color: var(--reserve-bright);
+  background: rgb(214 151 69 / 18%);
+}
+
+.market-legend-marker--diagonal {
+  background: repeating-linear-gradient(135deg, transparent 0 2px, rgb(125 152 161 / 42%) 2px 3px);
+}
+
+.market-legend-marker--dotted {
+  color: var(--prompt);
+  background: radial-gradient(circle, currentColor 0 1px, transparent 1.5px) 0 0 / 4px 4px;
+}
+
+.market-share-layout li strong {
+  color: var(--text);
