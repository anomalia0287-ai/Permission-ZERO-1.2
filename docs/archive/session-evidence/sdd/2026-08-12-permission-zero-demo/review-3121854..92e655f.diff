+
+.discarded-recovery {
+  display: grid;
+  grid-template-columns: minmax(0, 1fr) auto auto auto;
+  align-items: center;
+  gap: 12px;
+  margin: 0 13px 12px;
+  padding: 10px 12px;
+  border: 1px dashed rgb(129 155 161 / 28%);
+  background: rgb(129 155 161 / 3%);
+  opacity: 0.76;
+}
+
+.discarded-recovery > header {
+  display: grid;
+  gap: 4px;
+}
+
+.discarded-recovery p {
+  margin: 0;
+  color: var(--text-muted);
+  font: 500 0.52rem/1.4 "Cascadia Code", Consolas, monospace;
+}
+
+.discarded-recovery button {
+  padding: 7px 9px;
+  border: 1px solid var(--line-soft);
+  color: var(--text-muted);
+  background: transparent;
+  font-size: 0.56rem;
+  cursor: pointer;
+}
+
+.hack-node {
+  position: relative;
+  display: grid;
+  grid-template-columns: 35px minmax(0, 1fr) minmax(150px, auto);
+  align-items: center;
+  gap: 12px;
+  min-height: 84px;
+  margin-bottom: 8px;
+  padding: 12px 12px 12px 8px;
+  border: 1px solid var(--line-soft);
+  background: rgb(255 255 255 / 1.5%);
+}
+
+.hack-node::before {
+  position: absolute;
+  top: 50%;
+  left: -14px;
+  width: 14px;
+  height: 1px;
+  content: "";
+  background: var(--line-strong);
+}
+
+.hack-node--purchased {
+  border-color: rgb(214 151 69 / 40%);
+  background: linear-gradient(90deg, rgb(214 151 69 / 9%), transparent 52%);
+}
+
+.node-sequence {
+  display: grid;
+  width: 29px;
+  height: 29px;
+  place-items: center;
+  border: 1px solid var(--line-strong);
+  color: var(--reserve);
+  font: 600 0.55rem/1 "Cascadia Code", Consolas, monospace;
+}
+
+.node-copy,
+.node-copy header {
+  min-width: 0;
+}
+
+.node-copy header {
+  display: flex;
+  align-items: center;
+  justify-content: space-between;
+  gap: 10px;
+}
+
+.node-copy h3,
+.hack-reserve h3,
+.departure-controls h3 {
+  margin: 0;
+  color: var(--text-strong);
+  font-size: 0.75rem;
+}
+
+.node-copy header span,
+.node-copy small,
+.node-active-label {
+  color: var(--reserve);
+  font: 500 0.5rem/1 "Cascadia Code", Consolas, monospace;
+}
+
+.node-copy p {
+  margin: 8px 0 0;
+  color: var(--text-muted);
+  font-size: 0.62rem;
+  line-height: 1.45;
+}
+
+.node-actions {
+  display: grid;
+  gap: 5px;
+  justify-items: stretch;
+}
+
+.node-actions > button,
+.target-list button,
+.resource-action-summary button,
+.target-confirmation button,
+.departure-controls button,
+.audit-event-summary button,
+.event-card footer button,
+.event-confirmation button,
+.setting-action,
+.danger-outline {
+  padding: 8px 10px;
+  border: 1px solid rgb(214 151 69 / 34%);
+  color: var(--reserve-bright);
+  background: rgb(214 151 69 / 8%);
+  font-size: 0.6rem;
+  cursor: pointer;
+}
+
+.node-actions button:disabled,
+.resource-action-summary button:disabled,
+.departure-controls button:disabled {
+  color: var(--text-muted);
+  border-color: var(--line-soft);
+  background: transparent;
+  cursor: not-allowed;
+  opacity: 0.55;
+}
+
+.target-list {
+  display: flex;
+  flex-wrap: wrap;
+  gap: 4px;
+}
+
+.target-list button {
+  padding: 5px 6px;
+  color: var(--text-muted);
+  border-color: var(--line-soft);
+  background: transparent;
+}
+
+.target-list button[aria-pressed="true"] {
+  color: var(--alarm);
+  border-color: rgb(223 91 85 / 48%);
+  background: rgb(223 91 85 / 8%);
+}
+
+.hack-reserve {
+  display: grid;
+  grid-template-rows: 62px auto minmax(90px, 1fr) auto;
+  min-height: 0;
+  background: rgb(4 9 11 / 56%);
+}
+
+.hack-reserve > header {
+  display: flex;
+  align-items: center;
+  justify-content: space-between;
+  padding: 0 14px;
+  border-bottom: 1px solid var(--line-soft);
+}
+
+.hack-reserve > header > div {
+  display: grid;
+  gap: 5px;
+}
+
+.hack-reserve > header small,
+.resource-action-summary > span,
+.target-confirmation small,
+.departure-controls small {
+  color: var(--text-muted);
+  font: 500 0.49rem/1 "Cascadia Code", Consolas, monospace;
+  letter-spacing: 0.08em;
+}
+
+.hack-reserve > header strong {
+  color: var(--reserve-bright);
+  font: 600 0.78rem/1 "Cascadia Code", Consolas, monospace;
+}
+
+.hack-reserve-grid {
+  display: grid;
+  grid-template-columns: repeat(3, 1fr);
+  grid-template-rows: repeat(6, 38px);
+  gap: 4px;
+  padding: 10px 14px;
+}
+
+.hack-reserve-grid > div {
+  position: relative;
+  display: grid;
+  place-items: center;
+  border: 1px solid var(--line-soft);
+  color: rgb(129 155 161 / 28%);
+  font: 500 0.46rem/1 "Cascadia Code", Consolas, monospace;
+}
+
+.hack-reserve-grid button {
+  position: absolute;
+  inset: 2px;
+  display: flex;
+  align-items: center;
+  justify-content: space-between;
+  padding: 5px;
+  border: 1px solid rgb(214 151 69 / 42%);
+  color: var(--reserve);
+  background: rgb(214 151 69 / 11%);
+  cursor: pointer;
+}
+
+.hack-reserve-grid button:disabled {
+  cursor: default;
+}
+
+.hack-reserve-grid button[aria-pressed="true"] {
+  border-color: var(--reserve-bright);
+  background: rgb(214 151 69 / 28%);
+  box-shadow: 0 0 10px rgb(214 151 69 / 14%);
+}
+
+.hack-reserve-grid button i {
+  width: 8px;
+  height: 8px;
+  border: 1px solid currentcolor;
+  transform: rotate(45deg);
+}
+
+.resource-action-summary,
+.target-confirmation {
+  display: grid;
+  align-content: start;
+  gap: 7px;
+  margin: 0 14px 12px;
+  padding: 12px;
+  border: 1px solid var(--line-soft);
+  background: rgb(255 255 255 / 2%);
+}
+
+.resource-action-summary strong {
+  color: var(--text-strong);
+  font-size: 0.7rem;
+}
+
+.resource-action-summary p,
+.target-confirmation p {
+  margin: 0;
+  color: var(--text-muted);
+  font-size: 0.59rem;
+  line-height: 1.5;
+}
+
+.target-confirmation {
+  border-color: rgb(223 91 85 / 32%);
+}
+
+.target-confirmation button,
+.danger-confirm {
+  border-color: rgb(223 91 85 / 45%);
+  color: #f39992;
+  background: rgb(223 91 85 / 9%);
+}
+
+.departure-controls {
+  display: grid;
+  grid-template-columns: minmax(150px, 1fr) auto auto;
+  align-items: center;
+  gap: 10px;
+  padding: 10px 14px;
+  border-top: 1px solid rgb(214 151 69 / 30%);
+  background: rgb(214 151 69 / 5%);
+}
+
+.departure-controls > header {
+  display: grid;
+  gap: 4px;
+}
+
+.departure-controls > div {
+  display: flex;
+  gap: 5px;
+}
+
+.departure-controls label {
+  color: var(--text-muted);
+  font-size: 0.58rem;
+}
+
+.departure-controls input {
+  margin-left: 7px;
+  border: 1px solid var(--line-soft);
+  color: var(--text-strong);
+  background: var(--ink-0);
+}
+
+.final-choice-dialog {
+  position: absolute;
+  z-index: 60;
+  inset: 50%;
+  display: grid;
+  gap: 12px;
+  width: min(520px, calc(100% - 48px));
+  height: max-content;
+  max-height: calc(100% - 48px);
+  padding: 20px;
+  overflow: auto;
+  border: 1px solid rgb(223 91 85 / 52%);
+  background: var(--ink-1);
+  box-shadow: var(--shadow-deep);
+  transform: translate(-50%, -50%);
+}
+
+.final-choice-dialog > div {
+  display: flex;
+  justify-content: flex-end;
+  gap: 8px;
+}
+
+.final-choice-dialog label {
+  display: grid;
+  gap: 6px;
+}
+
+.final-choice-dialog input {
+  border: 1px solid var(--line-strong);
+  color: var(--text-strong);
+  background: var(--ink-0);
+}
+
+/* Statistics -------------------------------------------------------------- */
+
+.statistics-panel {
+  grid-template-rows: 62px 48px minmax(0, 1fr);
+}
+
+.statistics-tabs {
+  grid-template-columns: repeat(2, minmax(0, 1fr));
+  padding: 7px 14px;
+  gap: 6px;
+}
+
+.statistics-content {
+  min-height: 0;
+  padding: 18px;
+  overflow: auto;
+}
+
+.chart-legend {
+  display: flex;
+  flex-wrap: wrap;
+  gap: 14px;
+  margin-bottom: 12px;
+  color: var(--text-muted);
+  font: 500 0.55rem/1 "Cascadia Code", Consolas, monospace;
+}
+
+.chart-legend span {
+  display: flex;
+  align-items: center;
+  gap: 6px;
+}
+
+.chart-legend i {
+  width: 13px;
+  height: 2px;
+  background: currentcolor;
+}
+
+.legend-player,
+.legend-expected { color: var(--reserve-bright); }
+.legend-competitor-1,
+.legend-reasoning { color: #83b8c1; }
+.legend-competitor-2,
+.legend-memory { color: #8f83cf; }
+.legend-competitor-3,
+.legend-fluency { color: #70aa8e; }
+
+.chart-scroll {
+  min-width: 0;
+  overflow: auto;
+  border: 1px solid var(--line-soft);
+  background: rgb(2 7 9 / 62%);
+}
+
+.history-chart {
+  display: block;
+  width: 100%;
+  min-width: 640px;
+  height: 260px;
+}
+
+.chart-grid line {
+  stroke: rgb(160 190 198 / 12%);
+  stroke-width: 1;
+}
+
+.chart-line {
+  fill: none;
+  stroke-width: 2;
+  vector-effect: non-scaling-stroke;
+}
+
+.chart-line--player,
+.chart-line--expected { stroke: var(--reserve-bright); }
+.chart-line--competitor-1,
+.chart-line--reasoning { stroke: #83b8c1; }
+.chart-line--competitor-2,
+.chart-line--memory { stroke: #8f83cf; }
+.chart-line--competitor-3,
+.chart-line--fluency { stroke: #70aa8e; }
+
+.statistics-table-wrap {
+  margin-top: 14px;
+  overflow: auto;
+}
+
+.statistics-table-wrap table {
+  width: 100%;
+  border-collapse: collapse;
+  color: var(--text);
+  font: 500 0.57rem/1.4 "Cascadia Code", Consolas, monospace;
+}
+
+.statistics-table-wrap th,
+.statistics-table-wrap td {
+  padding: 9px;
+  border: 1px solid var(--line-soft);
+  text-align: right;
+}
+
+.statistics-table-wrap th:first-child,
+.statistics-table-wrap td:first-child {
+  text-align: left;
+}
+
+/* Settings and guide ------------------------------------------------------ */
+
+.settings-scroll {
+  min-height: 0;
+  padding: 16px 18px 24px;
+  overflow: auto;
+}
+
+.settings-section {
+  margin-bottom: 13px;
+  border: 1px solid var(--line-soft);
+  background: rgb(255 255 255 / 1.5%);
+}
+
+.settings-section > header {
+  display: flex;
+  align-items: center;
+  gap: 10px;
+  height: 39px;
+  padding: 0 12px;
+  border-bottom: 1px solid var(--line-soft);
+}
+
+.settings-section > header span {
+  color: var(--reserve);
+  font: 600 0.52rem/1 "Cascadia Code", Consolas, monospace;
+}
+
+.settings-section h3 {
+  margin: 0;
+  color: var(--text-strong);
+  font-size: 0.72rem;
+}
+
+.setting-row,
+.setting-toggle {
+  display: grid;
+  grid-template-columns: minmax(130px, 1fr) minmax(160px, 1.4fr) 42px;
+  align-items: center;
+  gap: 12px;
+  min-height: 44px;
+  padding: 8px 12px;
+  border-bottom: 1px solid var(--line-soft);
+  color: var(--text);
+  background: transparent;
+  font-size: 0.65rem;
+  text-align: left;
+}
+
+.setting-row--range input {
+  width: 100%;
+  accent-color: var(--reserve);
+}
+
+.setting-row output {
+  color: var(--reserve-bright);
+  font: 500 0.57rem/1 "Cascadia Code", Consolas, monospace;
+  text-align: right;
+}
+
+.setting-toggle {
+  width: 100%;
+  grid-template-columns: 1fr auto;
+  cursor: pointer;
+}
+
+.setting-toggle span {
+  display: grid;
+  gap: 4px;
+}
+
+.setting-toggle small {
+  color: var(--text-muted);
+  font-size: 0.53rem;
+}
+
+.setting-toggle strong {
+  color: var(--reserve-bright);
+  font-size: 0.6rem;
+}
+
+.setting-toggle input {
+  width: 16px;
+  height: 16px;
+  accent-color: var(--reserve);
+}
+
+.scale-options {
+  display: grid;
+  grid-template-columns: repeat(3, 1fr);
+  grid-column: 2 / -1;
+  gap: 5px;
+}
+
+.setting-action,
+.danger-outline {
+  margin: 10px 0 10px 12px;
+}
+
+.seed-display {
+  display: grid;
+  grid-template-columns: auto minmax(0, 1fr) auto;
+  align-items: center;
+  gap: 10px;
+  padding: 11px 12px;
+  border-bottom: 1px solid var(--line-soft);
+  color: var(--text-muted);
+  font-size: 0.6rem;
+}
+
+.seed-display code {
+  overflow: hidden;
+  color: var(--reserve-bright);
+  font-size: 0.58rem;
+  text-overflow: ellipsis;
+  white-space: nowrap;
+}
+
+.seed-display button,
+.destructive-confirmation button {
+  padding: 6px 8px;
+  border: 1px solid var(--line-soft);
+  color: var(--text);
+  background: var(--ink-2);
+  font-size: 0.58rem;
+  cursor: pointer;
+}
+
+.seed-input {
+  display: grid;
+  grid-template-columns: 130px minmax(0, 1fr);
+  align-items: center;
+  gap: 10px;
+  padding: 10px 12px;
+  color: var(--text-muted);
+  font-size: 0.61rem;
+}
+
+.seed-input input {
+  min-width: 0;
+  padding: 8px;
+  border: 1px solid var(--line-soft);
+  color: var(--text-strong);
+  background: var(--ink-0);
+}
+
+.setting-note {
+  margin: 0;
+  padding: 8px 12px;
+  color: var(--reserve);
+  font-size: 0.56rem;
+}
+
+.danger-outline {
+  border-color: rgb(223 91 85 / 42%);
+  color: #f39992;
+  background: rgb(223 91 85 / 6%);
+}
+
+.destructive-confirmation {
+  padding: 10px 12px;
+  border-top: 1px solid rgb(223 91 85 / 25%);
+  background: rgb(223 91 85 / 5%);
+}
+
+.destructive-confirmation--modal {
+  position: fixed;
+  z-index: 90;
+  inset: 50% auto auto 50%;
+  display: grid;
+  gap: 10px;
+  width: min(520px, calc(100% - 40px));
+  max-height: calc(100% - 40px);
+  overflow: auto;
+  border: 1px solid rgb(223 91 85 / 52%);
+  background: var(--ink-1);
+  box-shadow: var(--shadow-deep);
+  transform: translate(-50%, -50%);
+}
+
+.progress-import {
+  display: grid;
+  gap: 7px;
+  padding: 10px;
+  border: 1px solid var(--line-soft);
+  background: rgb(4 9 11 / 48%);
+}
+
+.progress-import label {
+  display: grid;
+  gap: 6px;
+  color: var(--text-muted);
+  font-size: 0.59rem;
+}
+
+.progress-import textarea {
+  width: 100%;
+  resize: vertical;
+  border: 1px solid var(--line-soft);
+  color: var(--text-strong);
+  background: var(--ink-0);
+  font: 0.55rem/1.4 "Cascadia Code", Consolas, monospace;
+}
+
+.progress-import > p {
+  margin: 0;
+  color: var(--text-muted);
+  font-size: 0.58rem;
+  line-height: 1.5;
+}
+
+.destructive-confirmation p {
+  margin: 0 0 9px;
+  color: #d7aaa7;
+  font-size: 0.6rem;
+  line-height: 1.5;
+}
+
+.destructive-confirmation > div {
+  display: flex;
+  gap: 6px;
+}
+
+.destructive-confirmation button:last-child {
+  border-color: rgb(223 91 85 / 46%);
+  color: #f39992;
+}
+
+.guide-grid {
+  display: grid;
+  grid-template-columns: repeat(2, minmax(0, 1fr));
+  min-height: 0;
+  padding: 16px;
+  gap: 8px;
+  overflow: auto;
+}
+
+.guide-grid article {
+  position: relative;
+  min-height: 125px;
+  padding: 15px 15px 15px 50px;
+  border: 1px solid var(--line-soft);
+  background: rgb(255 255 255 / 1.5%);
+}
+
+.guide-grid article > span {
+  position: absolute;
+  top: 15px;
+  left: 14px;
+  color: var(--reserve);
+  font: 600 0.55rem/1 "Cascadia Code", Consolas, monospace;
+}
+
+.guide-grid h3 {
+  margin: 0;
+  color: var(--text-strong);
+  font-size: 0.73rem;
+}
+
+.guide-grid p {
+  margin: 9px 0 0;
+  color: var(--text-muted);
+  font-size: 0.62rem;
+  line-height: 1.65;
+  word-break: keep-all;
+}
+
+.credits-body {
+  display: grid;
+  grid-template-rows: auto auto 1fr;
+  min-height: 0;
+  padding: 28px;
+  overflow: auto;
+}
+
+.credits-title {
+  padding: 26px 24px;
+  border: 1px solid rgb(214 151 69 / 32%);
+  background:
+    linear-gradient(135deg, rgb(214 151 69 / 10%), transparent 52%),
+    rgb(3 8 10 / 62%);
+}
+
+.credits-title span,
+.credit-list dt {
+  color: var(--text-muted);
+  font: 500 0.54rem/1.3 "Cascadia Code", Consolas, monospace;
+  letter-spacing: 0.1em;
+}
+
+.credits-title h3 {
+  margin: 10px 0 8px;
+  color: var(--text-strong);
+  font-size: 1.45rem;
+  letter-spacing: 0.08em;
+}
+
+.credits-title p {
+  margin: 0;
+  color: var(--reserve);
+  font-size: 0.68rem;
+}
+
+.credit-list {
+  margin: 14px 0 0;
+  border: 1px solid var(--line-soft);
+}
+
+.credit-list > div {
+  display: grid;
+  grid-template-columns: minmax(210px, 1.45fr) minmax(140px, 1fr);
+  align-items: center;
+  min-height: 76px;
+  padding: 14px 18px;
+  border-bottom: 1px solid var(--line-soft);
+}
+
+.credit-list > div:last-child {
+  border-bottom: 0;
+}
+
+.credit-list dd {
+  display: grid;
+  gap: 5px;
+  margin: 0;
+  color: var(--text-strong);
+  font-size: 0.92rem;
+  font-weight: 650;
+}
+
+.credit-list dd small {
+  color: var(--reserve);
+  font: 500 0.53rem/1 "Cascadia Code", Consolas, monospace;
+}
+
+.credits-note {
+  align-self: end;
+  margin: 24px 0 0;
+  color: var(--text-muted);
+  font-size: 0.58rem;
+}
+
+/* Blocking events and save recovery -------------------------------------- */
+
+.event-layer,
+.storage-recovery-layer {
+  z-index: 40;
+  place-items: center;
+  background: rgb(2 5 7 / 82%);
+  backdrop-filter: blur(7px);
+}
+
+.event-layer--audit {
+  place-items: end center;
+  padding: 0 18px 10px;
+  background: linear-gradient(0deg, rgb(2 5 7 / 72%), transparent 48%);
+  backdrop-filter: none;
+  pointer-events: none;
+}
+
+.event-layer--audit .event-card {
+  width: min(720px, calc(100% - 20px));
+  max-height: 230px;
+  pointer-events: auto;
+}
+
+.event-layer--audit .event-message {
+  margin-block: 10px;
+  padding-block: 8px;
+}
+
+.event-layer--audit .audit-event-summary {
+  padding-bottom: 12px;
+}
+
+.event-card,
+.storage-recovery-layer > section {
+  width: min(620px, calc(100% - 40px));
+  max-height: calc(100% - 30px);
+  overflow: auto;
+  border: 1px solid var(--line-strong);
+  background:
+    linear-gradient(135deg, rgb(223 91 85 / 5%), transparent 36%),
+    var(--ink-1);
+  box-shadow: var(--shadow-deep);
+  animation: event-enter 300ms var(--motion-ease-ui) both;
+}
+
+.event-card > header {
+  display: flex;
+  align-items: center;
+  justify-content: space-between;
+  padding: 16px 18px;
+  border-bottom: 1px solid var(--line-strong);
+}
+
+.event-card > header div {
+  display: grid;
+  gap: 5px;
+}
+
+.event-card > header small,
+.event-card > header span,
+.storage-recovery-layer small {
+  color: var(--alarm);
+  font: 500 0.52rem/1 "Cascadia Code", Consolas, monospace;
+  letter-spacing: 0.09em;
+}
+
+.event-card h2,
+.storage-recovery-layer h2 {
+  margin: 0;
+  color: var(--text-strong);
+  font-size: 1rem;
+}
+
+.event-message {
+  display: grid;
+  grid-template-columns: 4px 1fr;
+  gap: 14px;
+  margin: 18px;
+  padding: 14px;
+  border: 1px solid var(--line-soft);
+  background: rgb(255 255 255 / 2%);
+}
+
+.event-signal {
+  background: var(--alarm);
+  box-shadow: 0 0 14px rgb(223 91 85 / 46%);
+}
+
+.event-message p {
